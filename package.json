{
  "name": "centrypto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "ci": "npm run lint && npm run typecheck && npm test -- --run && npm run build",
    "test": "vitest",
    "test:market-parity": "vitest run --config vitest.market.config.mts",
    "runtime:status": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/runtime_status.ts",
    "desk:install": "node scripts/install_trading_desk.mjs",
    "desk:worker": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/start_trading_desk.ts",
    "runtime:local": "python3 scripts/start_local_runtime.py",
    "prisma:generate:main": "prisma generate --schema prisma/schema.prisma && node scripts/prepare_app_postgres.mjs && prisma generate --schema prisma/app-postgres/schema.prisma",
    "prisma:generate:market": "prisma generate --schema prisma/runtime-market/schema.prisma",
    "prisma:generate": "npm run prisma:generate:main && npm run prisma:generate:market && npm run prisma:generate:backtest && npm run prisma:generate:news",
    "prisma:migrate": "node scripts/migrate_app.mjs",
    "collector": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/start_collector.ts",
    "backfill": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/manual_backfill.ts",
    "backtest:features": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/backtest_features.ts",
    "backtest:download:l2": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/download_hl_l2.ts",
    "backtest:candles": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/backtest_candles.ts",
    "backtest:parquet": ".venv-backtest/bin/python scripts/backtest_parquet.py",
    "prisma:generate:backtest": "prisma generate --schema prisma/market/schema.prisma",
    "intelligence:worker": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/start_intelligence_worker.ts",
    "codex:check": "npm run intelligence:worker -- --check-only",
    "collector:news": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config collector/server.ts",
    "collector:build": "node scripts/build_collectors.mjs",
    "prisma:generate:news": "prisma generate --schema prisma/news/schema.prisma",
    "research:worker": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/start_research_worker.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2",
    "@nktkas/hyperliquid": "^0.27.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.10",
    "ajv": "^8.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "ethers": "^6.11.1",
    "lightweight-charts": "^5.0.9",
    "lucide-react": "^0.378.0",
    "next": "14.2.3",
    "openai": "^6.9.1",
    "pino-pretty": "^13.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "rss-parser": "^3.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "viem": "^2.9.31",
    "wagmi": "^2.19.4",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "baseline-browser-mapping": "^2.10.23",
    "esbuild": "0.27.7",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.38",
    "prisma": "^5.22.0",
    "puppeteer": "^24.31.0",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.19.1",
    "typescript": "^5",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
