generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/market-client"
}

datasource db {
  provider = "postgresql"
  url      = env("MARKET_DATABASE_URL")
}

model MarketTick {
  id           Int      @id @default(autoincrement())
  ts           DateTime @default(now())
  symbol       String

  markPrice    Float
  indexPrice   Float?
  openInterest Float?
  fundingRate  Float?
  volume24h    Float?

  // optional small derived stuff
  bookBidPx    Float?
  bookBidSz    Float?
  bookAskPx    Float?
  bookAskSz    Float?
  receivedAt   DateTime?
  bookEventAt  DateTime?
  bookReceivedAt DateTime?
  source       String?

  @@index([ts])
  @@index([symbol, ts])
}

model MarketCandle {
  id        Int      @id @default(autoincrement())
  symbol    String
  timeframe String   // "1m", "5m", etc.
  openTime  DateTime

  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  source    String?
  receivedAt DateTime?

  @@unique([symbol, timeframe, openTime])
  @@index([symbol, timeframe, openTime])
  @@index([timeframe, openTime, symbol])
}

// Append-only observations; latest MarketCandle remains a convenience view.
// Legacy rows have no inferred receipt history.
model MarketCandleObservation {
  id          BigInt   @id @default(autoincrement())
  symbol      String
  timeframe   String
  openTime    DateTime
  closeTime   DateTime
  receivedAt  DateTime
  recordedAt  DateTime @default(now())
  source      String
  open        Float
  high        Float
  low         Float
  close       Float
  volume      Float

  @@index([symbol, timeframe, openTime, receivedAt])
  @@index([recordedAt])
}
