generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// LLM Decision Tracking Models
model LlmQuery {
  id        Int           @id @default(autoincrement())
  prompt    String
  response  String
  createdAt DateTime      @default(now())
  isTestnet Boolean       @default(true)
  decisions LlmDecision[]
}

model LlmDecision {
  id             Int      @id @default(autoincrement())
  queryId        Int
  query          LlmQuery @relation(fields: [queryId], references: [id])
  action         String
  symbol         String
  confidence     Float
  reasonCode     String?
  notes          String?
  side           String?
  sizeFraction   Float?
  targetSide     String?
  targetSize     Float?
  playbook       String?
  riskPlan       String? // JSON
  createdAt      DateTime @default(now())
}

// Market Data Models
model MarketStateSnapshot {
  id        Int      @id @default(autoincrement())
  data      String
  createdAt DateTime @default(now())
}

model ScreeningSnapshot {
  id        Int      @id @default(autoincrement())
  data      String
  createdAt DateTime @default(now())
}

// Sentiment & Social Data Models
model Message {
  id             Int      @id @default(autoincrement())
  externalId     String
  source         String
  symbol         String
  text           String
  ts             DateTime
  likeCount      Int?
  retweetCount   Int?
  replyCount     Int?
  sentimentScore Float?
  sentimentConf  Float?
  tagsJson       String?
  language       String?

  @@unique([externalId, source, symbol])
  @@index([symbol, ts])
}

model SymbolBaseline {
  id             Int      @id @default(autoincrement())
  symbol         String   @unique
  avgMentions24h Float
  updatedAt      DateTime
}

model SymbolSentimentSnapshot {
  id                 Int      @id @default(autoincrement())
  symbol             String
  windowMinutes      Int
  score              Float
  change2h           Float
  mentions           Int
  mentionsVsBaseline Float
  disagreement       Float
  sourceMixJson      String
  tagsJson           String
  updatedAt          DateTime @default(now())

  @@index([symbol, windowMinutes, updatedAt])
  @@index([symbol, updatedAt])
}

// Trading Models
model Trade {
  id           String    @id
  symbol       String
  side         String
  entryPrice   Float
  exitPrice    Float?
  size         Float
  leverage     Float     @default(1)
  realizedPnl  Float?
  fees         Float     @default(0)
  status       String    @default("open")
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  userAddress  String
  strategyName String?

  @@index([openedAt])
  @@index([symbol, userAddress])
  @@index([userAddress, status])
}

model PriceAlert {
  id            String    @id
  symbol        String
  condition     String
  targetPrice   Float
  percentChange Float?
  isActive      Boolean   @default(true)
  triggered     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  triggeredAt   DateTime?
  userAddress   String

  @@index([symbol, isActive])
  @@index([userAddress, isActive, triggered])
}

// Analysis Job Tracking
model AnalysisJob {
  id            String    @id @default(uuid())
  status        String    // 'pending', 'running', 'completed', 'failed', 'cancelled'
  userAddress   String?
  isTestnet     Boolean   @default(true)
  model         String
  config        String?   // JSON serialized config
  result        String?   // JSON serialized result
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?
  
  @@index([status, createdAt])
  @@index([userAddress, status])
}
