generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Message {
  id             Int      @id @default(autoincrement())
  externalId     String
  source         String
  symbol         String
  text           String
  ts             DateTime
  likeCount      Int?
  retweetCount   Int?
  replyCount     Int?
  language       String?
  sentimentScore Float?
  sentimentConf  Float?
  tagsJson       String?

  @@unique([externalId, source, symbol])
  @@index([symbol, ts])
}

model SymbolBaseline {
  id             Int      @id @default(autoincrement())
  symbol         String   @unique
  avgMentions24h Float
  updatedAt      DateTime @updatedAt
}

model SymbolSentimentSnapshot {
  id                 Int      @id @default(autoincrement())
  symbol             String
  windowMinutes      Int
  score              Float
  change2h           Float
  mentions           Int
  mentionsVsBaseline Float
  disagreement       Float
  sourceMixJson      String
  tagsJson           String
  updatedAt          DateTime @default(now())

  @@index([symbol, updatedAt])
  @@index([symbol, windowMinutes, updatedAt])
}

model Candle {
  id        Int      @id @default(autoincrement())
  symbol    String
  interval  String
  t         BigInt   // Timestamp (ms)
  o         Float
  h         Float
  l         Float
  c         Float
  v         Float
  
  @@unique([symbol, interval, t])
  @@index([symbol, interval, t])
}

model ScreeningSnapshot {
  id        Int      @id @default(autoincrement())
  data      String   // JSON string of ScreenedSymbol[]
  createdAt DateTime @default(now())
}

model MarketStateSnapshot {
  id        Int      @id @default(autoincrement())
  data      String   // JSON string of EnrichedMarketData[] (ALL symbols)
  createdAt DateTime @default(now())
}

model PriceAlert {
  id            String   @id @default(uuid())
  symbol        String
  condition     String   // 'above' | 'below' | 'percent_change_up' | 'percent_change_down'
  targetPrice   Float
  percentChange Float?
  isActive      Boolean  @default(true)
  triggered     Boolean  @default(false)
  createdAt     DateTime @default(now())
  triggeredAt   DateTime?
  userAddress   String

  @@index([userAddress, isActive, triggered])
  @@index([symbol, isActive])
}

model Trade {
  id              String   @id @default(uuid())
  symbol          String
  side            String   // 'long' | 'short'
  entryPrice      Float
  exitPrice       Float?
  size            Float
  leverage        Float    @default(1)
  realizedPnl     Float?
  fees            Float    @default(0)
  status          String   @default("open") // 'open' | 'closed'
  openedAt        DateTime @default(now())
  closedAt        DateTime?
  userAddress     String
  strategyName    String?  // Optional: which strategy/AI decision led to this

  @@index([userAddress, status])
  @@index([symbol, userAddress])
  @@index([openedAt])
}

