generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// LLM Decision Tracking Models
model LlmQuery {
  id        Int           @id @default(autoincrement())
  prompt    String
  response  String
  createdAt DateTime      @default(now())
  isTestnet Boolean       @default(true)
  decisions LlmDecision[]
  autoTraderRuns AutoTraderRun[]
}

model LlmDecision {
  id           Int      @id @default(autoincrement())
  queryId      Int
  query        LlmQuery @relation(fields: [queryId], references: [id])
  action       String
  symbol       String
  confidence   Float
  reasonCode   String?
  notes        String?
  side         String?
  sizeFraction Float?
  targetSide   String?
  targetSize   Float?
  playbook     String?
  riskPlan     String? // JSON
  createdAt    DateTime @default(now())
}

// Market Data Models
model MarketStateSnapshot {
  id        Int      @id @default(autoincrement())
  data      String
  createdAt DateTime @default(now())
}

model ScreeningSnapshot {
  id        Int      @id @default(autoincrement())
  data      String
  createdAt DateTime @default(now())
}

model CandidateJournal {
  id              Int      @id @default(autoincrement())
  snapshotId      Int?
  timestamp       Int
  profile         String?
  regime          String
  candidateId     String?
  symbol          String
  side            String?
  playbook        String?
  scope           String
  status          String
  llmAction       String?
  llmConfidence   Float?
  llmNotes        String?
  validatorStatus String?
  validatorReason String?
  executed        Boolean  @default(false)
  promotionReason String?
  demotionReason  String?
  matchedPriorBucket String?
  configEpoch     DateTime?
  metadataJson    String?
  outcome5mBps    Float?
  outcome15mBps   Float?
  outcome1hBps    Float?
  createdAt       DateTime @default(now())

  @@index([snapshotId])
  @@index([symbol, createdAt])
  @@index([status, createdAt])
  @@index([candidateId])
}

model OpportunityJournal {
  id                         String   @id @default(uuid())
  accountAddress             String?
  network                    String
  snapshotId                 Int?
  timestamp                  DateTime @default(now())
  symbol                     String
  side                       String
  discoveryReasonsJson       String
  status                     String
  inPlayScore                Float?
  setupType                  String?
  setupScore                 Float?
  playbook                   String?
  reasonsJson                String
  warningsJson               String
  featuresJson               String
  executionTradeable         Boolean
  executionBlockReasonsJson  String
  promotionReason            String?
  demotionReason             String?
  matchedPriorBucket         String?
  configEpoch                DateTime?
  pathQuality                String?
  policyOutcome              String?
  priceAtSignal              Float?
  outcome5mJson              String?
  outcome15mJson             String?
  outcome1hJson              String?
  outcome4hJson              String?
  createdAt                  DateTime @default(now())

  @@index([network, symbol, createdAt])
  @@index([status, createdAt])
  @@index([setupType, createdAt])
}

// Sentiment & Social Data Models
model Message {
  id             Int      @id @default(autoincrement())
  externalId     String
  source         String
  symbol         String
  text           String
  ts             DateTime
  likeCount      Int?
  retweetCount   Int?
  replyCount     Int?
  sentimentScore Float?
  sentimentConf  Float?
  tagsJson       String?
  language       String?

  @@unique([externalId, source, symbol])
  @@index([symbol, ts])
}

model SymbolBaseline {
  id             Int      @id @default(autoincrement())
  symbol         String   @unique
  avgMentions24h Float
  updatedAt      DateTime
}

model SymbolSentimentSnapshot {
  id                 Int      @id @default(autoincrement())
  symbol             String
  windowMinutes      Int
  score              Float
  change2h           Float
  mentions           Int
  mentionsVsBaseline Float
  disagreement       Float
  sourceMixJson      String
  tagsJson           String
  updatedAt          DateTime @default(now())

  @@index([symbol, windowMinutes, updatedAt])
  @@index([symbol, updatedAt])
}

// Trading Models
model Trade {
  id           String    @id
  symbol       String
  side         String
  entryPrice   Float
  exitPrice    Float?
  size         Float
  leverage     Float     @default(1)
  realizedPnl  Float?
  fees         Float     @default(0)
  status       String    @default("open")
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  userAddress  String
  strategyName String?

  @@index([openedAt])
  @@index([symbol, userAddress])
  @@index([userAddress, status])
}

model PriceAlert {
  id            String    @id
  symbol        String
  condition     String
  targetPrice   Float
  percentChange Float?
  isActive      Boolean   @default(true)
  triggered     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  triggeredAt   DateTime?
  userAddress   String

  @@index([symbol, isActive])
  @@index([userAddress, isActive, triggered])
}

// Analysis Job Tracking
model AnalysisJob {
  id          String    @id @default(uuid())
  status      String // 'pending', 'running', 'completed', 'failed', 'cancelled'
  userAddress String?
  isTestnet   Boolean   @default(true)
  model       String
  config      String? // JSON serialized config
  result      String? // JSON serialized result
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status, createdAt])
  @@index([userAddress, status])
}

model AutoTraderSettings {
  id               String    @id @default(uuid())
  userAddress      String
  isTestnet        Boolean   @default(true)
  enabled          Boolean   @default(false)
  frequencySeconds Int       @default(600)
  model            String
  config           String?
  lastRunAt        DateTime?
  nextRunAt        DateTime?
  lastStatus       String?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userAddress, isTestnet])
  @@index([enabled, nextRunAt])
  @@index([userAddress, enabled])
}

model AutoTraderRun {
  id                    String                       @id @default(uuid())
  accountAddress        String
  agentWalletAddress    String?
  vaultAddress          String?
  subAccountAddress     String?
  network               String
  cycleType             String                       @default("SCHEDULED")
  model                 String
  strategyVersion       String?
  promptVersion         String?
  validatorVersion      String?
  codeVersion           String?
  configHash            String?
  configJson            String?
  marketSnapshotId      Int?
  llmQueryId            Int?
  llmQuery              LlmQuery?                    @relation(fields: [llmQueryId], references: [id])
  status                String
  error                 String?
  reliableSince         DateTime?
  startedAt             DateTime                     @default(now())
  finishedAt            DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  decisions             AutoTraderDecision[]
  positionSnapshots     AutoTraderPositionSnapshot[]
  tradeLifecycles       AutoTraderTradeLifecycle[]

  @@index([accountAddress, network, startedAt])
  @@index([status, startedAt])
  @@index([llmQueryId])
}

model AutoTraderDecision {
  id                     String                   @id @default(uuid())
  runId                  String
  run                    AutoTraderRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  decisionType           String
  candidateId            String?
  positionSnapshotId     String?
  positionSnapshot       AutoTraderPositionSnapshot? @relation(fields: [positionSnapshotId], references: [id])
  action                 String
  symbol                 String
  side                   String?
  confidence             Float?
  skipReason             String?
  rawLlmDecisionJson     String?
  normalizedDecisionJson String?
  preRiskDecisionJson    String?
  riskAssessmentJson     String?
  finalDecisionJson      String?
  finalRiskPlanJson      String?
  submittedOrderPlanJson String?
  validatorStatus        String?
  validatorErrorsJson    String?
  createdAt              DateTime                 @default(now())
  orderAttempts          AutoTraderOrderAttempt[]
  fills                  AutoTraderFill[]

  @@index([runId])
  @@index([symbol, action, createdAt])
  @@index([candidateId])
  @@index([positionSnapshotId])
}

model AutoTraderOrderAttempt {
  id                      String             @id @default(uuid())
  decisionId              String
  decision                AutoTraderDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  cloid                   String?
  oid                     String?
  batchId                 String?
  batchIndex              Int?
  nonce                   String?
  orderRole               String
  symbol                  String
  positionSide            String?
  orderSide               String
  reduceOnly              Boolean            @default(false)
  intendedSizeUsd         Float?
  intendedSizeCoin        Float?
  intendedLimitPx         Float?
  intendedStopLossPx      Float?
  intendedTakeProfitPx    Float?
  submittedAt             DateTime?
  exchangeReceivedAt      DateTime?
  latencyMs               Int?
  requestHash             String?
  status                  String
  statusReason            String?
  rawExchangeResponseJson String?
  rawExchangeErrorJson    String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  fills                   AutoTraderFill[]

  @@index([decisionId])
  @@index([cloid])
  @@index([oid])
  @@index([symbol, submittedAt])
}

model AutoTraderFill {
  id                 String                    @id @default(uuid())
  accountAddress     String
  agentWalletAddress String?
  network            String
  rawCoin            String
  normalizedSymbol   String
  px                 Float
  sz                 Float
  side               String?
  dir                String?
  closedPnl          Float                     @default(0)
  fee                Float                     @default(0)
  hash               String?
  oid                String?
  cloid              String?
  tid                String?
  time               DateTime
  fillType           String                    @default("UNKNOWN")
  attributionStatus  String                    @default("UNMATCHED")
  attributionMethod  String                    @default("UNMATCHED")
  orderAttemptId     String?
  orderAttempt       AutoTraderOrderAttempt?   @relation(fields: [orderAttemptId], references: [id])
  decisionId         String?
  decision           AutoTraderDecision?       @relation(fields: [decisionId], references: [id])
  lifecycleId        String?
  lifecycle          AutoTraderTradeLifecycle? @relation(fields: [lifecycleId], references: [id])
  dedupeKey          String                    @unique
  rawJson            String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([accountAddress, network, time])
  @@index([normalizedSymbol, time])
  @@index([oid])
  @@index([cloid])
  @@index([tid])
  @@index([orderAttemptId])
  @@index([decisionId])
  @@index([lifecycleId])
}

model AutoTraderPositionSnapshot {
  id              String                 @id @default(uuid())
  runId           String
  run             AutoTraderRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  phase           String
  symbol          String
  side            String
  entryPrice      Float
  sizeUsd         Float
  sizeCoin        Float?
  markPrice       Float?
  unrealizedPnl   Float
  liquidationPrice Float?
  leverage        Float?
  marginMode      String?
  observedAt      DateTime               @default(now())
  rawJson         String?
  decisions       AutoTraderDecision[]

  @@index([runId, phase])
  @@index([symbol, observedAt])
}

model AutoTraderTradeLifecycle {
  id                         String           @id @default(uuid())
  accountAddress             String
  network                    String
  symbol                     String
  side                       String
  openedAt                   DateTime
  closedAt                   DateTime?
  status                     String
  openFillIds                String
  closeFillIds               String
  attributedDecisionIds      String
  attributedOrderAttemptIds  String
  entryPrice                 Float
  exitPrice                  Float?
  sizeOpened                 Float
  sizeClosed                 Float             @default(0)
  grossRealizedPnl           Float             @default(0)
  fees                       Float             @default(0)
  netRealizedPnl             Float             @default(0)
  attributionMethod          String            @default("UNMATCHED")
  reconstructionVersion      String
  rawDebugJson               String?
  mfeBps                     Float?
  maeBps                     Float?
  mfeSource                  String            @default("UNKNOWN")
  mfeCoverage                String            @default("NONE")
  observedGreenToRed         Boolean           @default(false)
  lateGiveback               Boolean           @default(false)
  givebackPct                Float?
  openWasGreenNowRed         Boolean           @default(false)
  openLateGiveback           Boolean           @default(false)
  openGivebackPct            Float?
  closedGreenToRed           Boolean           @default(false)
  closedLateGiveback         Boolean           @default(false)
  closeAction                String?
  closeReasonCode            String?
  closeAttemptStatus         String?
  runId                      String?
  run                        AutoTraderRun?    @relation(fields: [runId], references: [id])
  fills                      AutoTraderFill[]
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  @@index([accountAddress, network, openedAt])
  @@index([symbol, status, openedAt])
  @@index([observedGreenToRed, lateGiveback])
  @@index([openWasGreenNowRed, openLateGiveback])
  @@index([closedGreenToRed, closedLateGiveback])
  @@index([runId])
}

model AutoTraderPositionState {
  id                   String   @id @default(uuid())
  accountAddress       String
  network              String
  lifecycleId          String?
  symbol               String
  side                 String
  state                String
  entryPrice           Float
  openedAt             DateTime
  highestMfeBps        Float?
  lowestMaeBps         Float?
  peakUnrealizedPnl    Float?
  partialTakenFraction Float    @default(0)
  protectedAt          DateTime?
  lastActionAt         DateTime?
  lastAction           String?
  lastReasonCode       String?
  lastStopPx           Float?
  lastTakeProfitPx     Float?
  policyVersion        String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([accountAddress, network, symbol, side, openedAt])
  @@index([accountAddress, network, symbol])
  @@index([lifecycleId])
}

model AutoTraderPositionManagementEvent {
  id                         String   @id @default(uuid())
  accountAddress             String
  network                    String
  runId                      String?
  lifecycleId                String?
  positionStateId            String?
  symbol                     String
  side                       String
  stateBefore                String
  stateAfter                 String
  action                     String
  urgency                    String
  bypassLlm                  Boolean
  reasonCode                 String
  notes                      String?
  targetSizeFractionOfEquity Float?
  reduceFraction             Float?
  stopReplacementJson        String?
  takeProfitReplacementJson  String?
  cancelOrderOidsJson        String?
  evidenceJson               String
  createdAt                  DateTime @default(now())

  @@index([accountAddress, network, createdAt])
  @@index([symbol, createdAt])
  @@index([lifecycleId])
  @@index([reasonCode])
}

model WalletRiskControl {
  id          String   @id @default(uuid())
  userAddress String
  isTestnet   Boolean  @default(true)
  killSwitch  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userAddress, isTestnet])
  @@index([userAddress, killSwitch])
}

model UserHyperliquidApiWallet {
  id                   String    @id @default(uuid())
  userAddress          String
  isTestnet            Boolean   @default(true)
  apiWalletAddress     String
  encryptedPrivateKey  String
  iv                   String
  authTag              String
  keyVersion           String    @default("v1")
  lastVerifiedAt       DateTime?
  delegationValidUntil DateTime?
  lastUsedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([userAddress, isTestnet])
  @@index([apiWalletAddress])
  @@index([userAddress, isTestnet, apiWalletAddress])
}

model NewsRunContext {
  id                 String   @id @default(uuid())
  ownerAddress       String
  snapshotId         Int?
  runId              String?
  briefingId         String?
  contextJson        String
  availableAt        DateTime @default(now())
  @@index([ownerAddress, snapshotId])
}

model CodexJob {
  id                 String   @id @default(uuid())
  ownerAddress       String
  purpose            String
  model              String
  payloadJson        String
  schemaJson         String
  metadataJson       String   @default("{}")
  status             String   @default("pending")
  priority           Int      @default(0)
  attempts           Int      @default(0)
  cancelRequested    Boolean  @default(false)
  notBefore          DateTime @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  resultJson         String?
  errorCode          String?
  usageJson          String?
  createdAt          DateTime @default(now())
  @@index([status, priority, notBefore])
  @@index([ownerAddress, createdAt])
}

model CodexRuntime {
  id                 String   @id @default("local")
  leaseOwner         String?
  leaseUntil         DateTime?
  heartbeatAt        DateTime?
  backoffUntil       DateTime?
  cliVersion         String?
  modelsJson         String   @default("{}")
  @@index([leaseUntil])
}

model DeskPublicCache {
  id         Int      @id @default(autoincrement())
  bookId     String
  book       DeskBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  scope      String
  key        String
  revision   Int
  fetchedAt  DateTime
  expiresAt  DateTime
  payload    String
  @@unique([bookId, scope, key])
  @@index([expiresAt])
  @@index([bookId, fetchedAt])
}

model DeskBook {
  publicCache      DeskPublicCache[]
  id               String @id @default(uuid())
  ownerAddress     String
  accountAddress   String
  isTestnet        Boolean
  kind             String
  enabled          Boolean @default(false)
  version          Int @default(1)
  mandateJson      String
  frequencySeconds Int @default(600)
  newsCursor       Int @default(0)
  nextReviewAt     DateTime @default(now())
  heartbeatAt      DateTime?
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  wakes            DeskWake[]
  shifts           DeskShift[]
  records          DeskRecord[]
  watches          DeskWatch[]
  @@unique([accountAddress, isTestnet])
  @@index([ownerAddress, isTestnet])
}

model DeskWake {
  id             String @id @default(uuid())
  bookId         String
  book           DeskBook @relation(fields:[bookId], references:[id])
  key            String
  kind           String
  mode           String
  priority       Int
  payload        String
  version        Int
  dueAt          DateTime
  expiresAt      DateTime?
  shiftId        String?
  shift          DeskShift? @relation(fields:[shiftId],references:[id])
  createdAt      DateTime @default(now())
  @@unique([bookId,key])
  @@index([bookId,shiftId,dueAt])
}

model DeskShift {
  id             String @id @default(uuid())
  bookId         String
  book           DeskBook @relation(fields:[bookId],references:[id])
  version        Int
  mode           String
  status         String
  lease          String?
  leaseUntil     DateTime?
  attempts       Int @default(1)
  briefJson      String
  error          String?
  createdAt      DateTime @default(now())
  endedAt        DateTime?
  wakes          DeskWake[]
  @@index([bookId,status,createdAt])
}

model DeskRecord {
  id             Int @id @default(autoincrement())
  bookId         String
  book           DeskBook @relation(fields:[bookId], references:[id])
  shiftId        String?
  key            String
  kind           String
  role           String
  dataJson       String
  createdAt      DateTime @default(now())
  @@unique([bookId,key])
  @@index([bookId,kind,id])
  @@index([bookId,shiftId])
}

model DeskWatch {
  id             String @id @default(uuid())
  bookId         String
  book           DeskBook @relation(fields:[bookId], references:[id])
  key            String
  mode           String
  kind           String
  instrumentId   String?
  eventKey       String?
  thesis         String
  deadline       DateTime
  threshold      Float?
  referencePrice Float?
  side           String?
  status         String @default("open")
  outcomeJson    String?
  createdAt      DateTime @default(now())
  @@unique([bookId,key])
  @@index([bookId,status,deadline])
}

model DeskIntent {
  id            String @id @default(uuid())
  bookId        String
  intentKey     String
  cloid         String @unique
  instrumentId  String
  asset         Int
  coin          String
  requestJson   String
  fingerprint   String
  state         String
  policyVersion Int
  oid           String?
  arrivalPrice  Float
  quantity      Float
  limitPrice    Float
  reservedUsd   Float
  side          String
  filledQty     Float @default(0)
  stopCloid     String?
  targetCloid   String?
  groupKey      String?
  reason        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([bookId, intentKey])
  @@index([bookId, state])
}

model DeskInventory {
  id           String @id @default(uuid())
  bookId       String
  instrumentId String
  quantity     Float
  basis        Float
  realizedUsd  Float @default(0)
  fundingUsd   Float @default(0)
  stopPrice    Float?
  targetPrice  Float?
  suspended    Boolean @default(false)
  reason       String?
  since        DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([bookId, instrumentId])
}
model DeskCashFlow {
  id           String @id @default(uuid())
  bookId       String
  venueKey     String
  intentId     String?
  instrumentId String
  kind         String
  quantity     Float
  price        Float
  feeUsd       Float
  pnlUsd       Float
  shortfallUsd Float
  occurredAt   DateTime
  @@unique([bookId, venueKey])
  @@index([bookId, occurredAt])
}
model DeskExecutionState {
  bookId        String @id
  quoteJson     String?
  cancelAt      DateTime?
  lastQuotedAt  DateTime?
  lastSync      DateTime?
  lastError     String?
  highWaterUsd  Float @default(0)
  drawdownUsd   Float @default(0)
  netPnlUsd     Float @default(0)
  unrealizedUsd Float @default(0)
  dailyPnlUsd   Float @default(0)
  dayKey        String?
  dayStartUsd   Float @default(0)
  updatedAt     DateTime @updatedAt
}
model DeskExecutionLease {
  key        String @id
  token      String
  expiresAt  DateTime
  nonce      BigInt @default(0)
}
model DeskPair {
  id         String @id @default(uuid())
  bookId     String
  intentKey  String
  planJson   String
  state      String
  deadline   DateTime
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([bookId, intentKey])
  @@index([bookId, state])
}

// One usage stream per ephemeral Codex thread, registered before turn/start.
model DeskTokenUsage {
  threadId String @id
  bookId String?
  shiftId String?
  role String
  kind String
  model String
  turnId String?
  status String @default("running")
  startedAt DateTime @default(now())
  finishedAt DateTime?
  reportedAt DateTime?
  totalTokens BigInt?
  inputTokens BigInt?
  cachedInputTokens BigInt?
  cacheWriteInputTokens BigInt?
  outputTokens BigInt?
  reasoningOutputTokens BigInt?
  @@index([bookId,model,startedAt])
}

model DeskTokenMeterEpoch {
  id Int @id
  installedAt DateTime @default(now())
}
