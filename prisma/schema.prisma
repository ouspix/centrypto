generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Message {
  id             Int      @id @default(autoincrement())
  externalId     String
  source         String
  symbol         String
  text           String
  ts             DateTime
  likeCount      Int?
  retweetCount   Int?
  replyCount     Int?
  language       String?
  sentimentScore Float?
  sentimentConf  Float?
  tagsJson       String?

  @@unique([externalId, source, symbol])
  @@index([symbol, ts])
}

model SymbolBaseline {
  id             Int      @id @default(autoincrement())
  symbol         String   @unique
  avgMentions24h Float
  updatedAt      DateTime @updatedAt
}

model SymbolSentimentSnapshot {
  id                 Int      @id @default(autoincrement())
  symbol             String
  windowMinutes      Int
  score              Float
  change2h           Float
  mentions           Int
  mentionsVsBaseline Float
  disagreement       Float
  sourceMixJson      String
  tagsJson           String
  updatedAt          DateTime @default(now())

  @@index([symbol, updatedAt])
  @@index([symbol, windowMinutes, updatedAt])
}

model Candle {
  id        Int      @id @default(autoincrement())
  symbol    String
  interval  String
  t         BigInt   // Timestamp (ms)
  o         Float
  h         Float
  l         Float
  c         Float
  v         Float
  
  @@unique([symbol, interval, t])
  @@index([symbol, interval, t])
}

model ScreeningSnapshot {
  id        Int      @id @default(autoincrement())
  data      String   // JSON string of ScreenedSymbol[]
  createdAt DateTime @default(now())
}

model MarketStateSnapshot {
  id        Int      @id @default(autoincrement())
  data      String   // JSON string of EnrichedMarketData[] (ALL symbols)
  createdAt DateTime @default(now())
}
